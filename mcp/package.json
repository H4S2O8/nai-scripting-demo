{
  "name": "novelai-image-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NovelAI image generation as an MCP server, sharing the request builder with the Scripting app.",
  "scripts": {
    "build": "esbuild stdio.ts http.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=dist --out-extension:.js=.mjs",
    "start": "node dist/stdio.mjs",
    "serve": "node dist/http.mjs",
    "test": "npm run build && node test_server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "aws4fetch": "^1.0.20",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
